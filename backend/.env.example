# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Backend Server Configuration
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://localhost:8080","http://localhost:8081"]'

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_placeholder
POSTGRES_DB=lenny_assistant
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
TEST_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}_test
# Local LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Cloud LLM Configuration (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_placeholder
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_LLM_PROVIDER=local

# Legacy Cloud LLM Configuration (Anthropic)
# ANTHROPIC_API_KEY=your_anthropic_api_key_placeholder
# ANTHROPIC_MODEL_NAME=claude-3-haiku-20240307
