# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Backend Server Configuration
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:5173"]'

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_LOCAL_MODELS=true

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_placeholder
POSTGRES_DB=lenny_assistant
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Connection string for FastAPI/SQLAlchemy
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Local LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
DEFAULT_LLM_PROVIDER=local

# Cloud LLM Configuration (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_placeholder
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Legacy Cloud LLM Configuration (Anthropic)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL_NAME=claude-3-5-sonnet-20240620

